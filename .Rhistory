#Stacked bar relative abundance at species level
MicroAlongINOCspeciesave<- aggregate(abundance~Sample + Abx_relativeinfxn + taxa + Microbiota, data= MicroAlongspeciesINOC, FUN=sum)
MicroAlongINOCspeciesave<- aggregate(abundance~taxa + Abx_relativeinfxn + Microbiota, data= MicroAlongINOCspeciesave, FUN=mean)
MicroAlongINOCspeciesave <- MicroAlongINOCspeciesave[which(MicroAlongINOCspeciesave$abundance > 0),]
MicroAlongINOCspeciesave$normalabundance <- MicroAlongINOCspeciesave$abundance/sum(MicroAlongINOCspeciesave$abundance)*100
ggplot(MicroAlongINOCspeciesave, aes(Abx_relativeinfxn, normalabundance, fill=taxa)) + geom_bar(stat = "identity", position="stack")+ facet_grid(cols = vars(Microbiota))+scale_x_discrete(limits=c("INOC"))+ theme(axis.text.x = element_text(angle = 90, hjust = 1))+scale_fill_manual(values=mycolors)
#Family level DOL10
MicroAlongDOL10familyave<-aggregate(abundance~Sample + DOL + taxa + Microbiota, data= MicroAlongDOL10family, FUN=sum)
MicroAlongDOL10familyave<- aggregate(abundance~taxa + DOL + Microbiota, data= MicroAlongDOL10familyave, FUN=mean)
MicroAlongDOL10familyave$uniqID<-paste(MicroAlongDOL10familyave$DOL,MicroAlongDOL10familyave$Microbiota,sep="_")
MicroAlongDOL10familyave<<- MicroAlongDOL10familyave[which(MicroAlongDOL10familyave$abundance > 0),]
MicroAlongDOL10familyave$normalabundance <- MicroAlongDOL10familyave$abundance/sum(MicroAlongDOL10familyave$abundance)*100
MicroAlongDOL10familyaveother<-ldply(
lapply(unique(MicroAlongDOL10familyave$uniqID),function(x){rbind(MicroAlongDOL10familyave[MicroAlongDOL10familyave$normalabundance>=1 & MicroAlongDOL10familyave$uniqID==x, c("taxa", "DOL", "Microbiota","normalabundance","uniqID")],
data.frame(taxa=c("Other"),
DOL=c(strsplit(x,"_")[[1]][1]),
Microbiota=strsplit(x,"_")[[1]][2],
normalabundance=sum(MicroAlongDOL10familyave$normalabundance[MicroAlongDOL10familyave$uniqID==x & MicroAlongDOL10familyave$normalabundance<1]),
uniqID=x
))})
)
